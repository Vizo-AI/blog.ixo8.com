---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatPostDate, postHref } from '../lib/posts';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const latest = posts.filter((post) => post.id !== featured?.id).slice(0, 8);

const hasFeaturedImage = Boolean(featured?.data.hero);
---
<BaseLayout>
  <section class="hero">
    <div class="shell">
      <div class="eyebrow">Research intelligence · AI systems · emerging technology</div>
      <h1>Understand the systems shaping what comes next.</h1>
      <p class="hero-copy">Source-aware research, engineering notes, and analysis designed for people who want signal rather than another feed.</p>
    </div>
  </section>

  {featured && (
    <section class="section">
      <div class="shell">
        <div class="section-head">
          <h2 class="section-title">Featured intelligence</h2>
          <span class="meta">Latest research brief</span>
        </div>
        <a
          class:list={['feature', { 'feature--with-image': hasFeaturedImage, 'feature--text-only': !hasFeaturedImage }]}
          href={postHref(featured)}
        >
          {hasFeaturedImage && (
            <div class="feature-visual">
              <img src={featured.data.hero} alt={featured.data.hero_alt ?? ''} loading="lazy" />
            </div>
          )}
          <div class="feature-copy">
            <div class="eyebrow">Analysis</div>
            <h2>{featured.data.title}</h2>
            <p>{featured.data.description ?? 'A deeper look at the forces, incentives, and implications behind the headline.'}</p>
            <div class="meta">{formatPostDate(featured.data.date)} · Read analysis →</div>
          </div>
        </a>
      </div>
    </section>
  )}

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <h2 class="section-title">Latest intelligence</h2>
        <a class="meta" href="/explore/">Explore archive →</a>
      </div>
      <div class="article-list">
        {latest.map((post) => (
          <a class="article-row" href={postHref(post)}>
            <span class="meta">{formatPostDate(post.data.date)}</span>
            <h3>{post.data.title}</h3>
            <span class="meta">Analysis →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell archive-cta">
      <div class="archive-cta-copy">
        <div class="eyebrow">Research archive</div>
        <h2>Search the intelligence layer.</h2>
        <p>Find ideas, companies, technologies, policy shifts, and prior analysis across the full publication.</p>
        <a class="button-link" href="/explore/">Open Explore <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
